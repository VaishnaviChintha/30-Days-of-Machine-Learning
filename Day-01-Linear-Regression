import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

# 1. Prepare the dataset
X = np.array([1, 2, 3, 4, 5, 6]).reshape(-1, 1)
y = np.array([30, 40, 50, 60, 70, 80])

# 2. Create the model
model = LinearRegression()

# 3. Train the model
model.fit(X, y)

# 4. Display the learned equation
print("Slope:", model.coef_[0])
print("Intercept:", model.intercept_)

# 5. Predict marks for 7 study hours
new_hours = np.array([[7]])
prediction = model.predict(new_hours)

print("Predicted marks:", prediction[0])

# 6. Evaluate the model on the training data
y_pred = model.predict(X)

print("MAE:", mean_absolute_error(y, y_pred))
print("MSE:", mean_squared_error(y, y_pred))
print("R2 Score:", r2_score(y, y_pred))

# 7. Visualize the data and regression line
plt.scatter(X, y, color="blue", label="Actual marks")
plt.plot(X, model.predict(X), label="Regression line")
plt.scatter(new_hours, prediction, color="red", label="Prediction")

plt.xlabel("Study Hours")
plt.ylabel("Marks")
plt.title("Linear Regression: Study Hours vs Marks")
plt.legend()
plt.show()
